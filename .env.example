# Copy to .env and fill in real values. .env is git-ignored.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lecture_prep:lecture_prep@localhost:5432/lecture_prep
TIMEZONE=Asia/Jerusalem

# Google (Calendar + Drive) - see "Connecting Google" in the README.
GOOGLE_CLIENT_SECRET_PATH=.secrets/google_client_secret.json
GOOGLE_TOKEN_PATH=.cache/google_token.json
# Calendars to read lectures from, as a JSON list. "primary" is your own calendar; to add a calendar
# shared with you, list its id: uv run python -m lecture_prep.google_api.calendars
CALENDAR_IDS=["primary"]
# Drive folder with one sub-folder per course.
DRIVE_LECTURES_FOLDER=Lectures

# Claude API - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Telegram - token from @BotFather; chat id from: uv run python -m lecture_prep.telegram.chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MORNING_HOUR=7
REMINDER_MINUTES=30
