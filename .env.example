# Copy to .env and fill in real values. .env is git-ignored.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lecture_prep:lecture_prep@localhost:5432/lecture_prep

# OneDrive (Microsoft Graph): the "Application (client) ID" of your Azure app registration.
MS_CLIENT_ID=
# Where the sign-in token is cached after `uv run python -m lecture_prep.onedrive.login`.
MS_TOKEN_CACHE_PATH=.cache/msal_token_cache.json
